# Virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo

# IDEs
.vscode/
.idea/

# Environment variables
.env

# Data (Ignore raw, processed, and external data)
# We only want to track code, not large datasets
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# MLflow
mlruns/

# Checkpoints
models/saved/*
!models/saved/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# OS specific
.DS_Store

\n# Databases\n*.db\n\n# Node modules\nfrontend/node_modules/\nfrontend/dist/\n\n# Scratch scripts\nscratch_*.py\nscripts/add_history*.py\nscripts/bloomberg*.py\nscripts/enrich_payload*.py\nscripts/fix_*.py\nscripts/update_*.py\nscripts/populate_*.py\nscripts/variation*.py\n